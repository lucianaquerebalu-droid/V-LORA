<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <meta
        name="description"
        content="VÉLORA - Selección premium de bebidas para cada ocasión."
    >

    <title>VÉLORA | Licorería Premium</title>

    <style>
        /* =========================
           VARIABLES
        ========================= */

        :root {
            --negro: #111111;
            --negro-suave: #1c1c1c;
            --dorado: #c9a45c;
            --dorado-claro: #e1c98c;
            --crema: #f7f3eb;
            --blanco: #ffffff;
            --gris: #777777;
            --borde: #ded8cc;
        }

        /* =========================
           RESET
        ========================= */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            background: var(--crema);
            color: var(--negro);
            line-height: 1.6;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        button {
            font-family: inherit;
            cursor: pointer;
        }

        /* =========================
           BARRA SUPERIOR
        ========================= */

        .aviso {
            background: var(--negro);
            color: var(--dorado-claro);
            text-align: center;
            padding: 9px;
            font-size: 12px;
            letter-spacing: 1px;
        }

        /* =========================
           HEADER
        ========================= */

        header {
            position: sticky;
            top: 0;
            z-index: 1000;

            background: rgba(17, 17, 17, 0.97);
            color: white;

            display: flex;
            align-items: center;
            justify-content: space-between;

            padding: 20px 7%;

            border-bottom: 1px solid #333;
        }

        .logo {
            font-family: Georgia, serif;
            font-size: 28px;
            letter-spacing: 5px;
            color: var(--dorado-claro);
        }

        .logo span {
            display: block;
            font-family: Arial, sans-serif;
            font-size: 8px;
            letter-spacing: 6px;
            text-align: center;
            color: white;
        }

        nav {
            display: flex;
            gap: 30px;
        }

        nav a {
            font-size: 13px;
            transition: 0.3s;
        }

        nav a:hover {
            color: var(--dorado-claro);
        }

        .carrito-btn {
            background: transparent;
            color: white;
            border: 1px solid var(--dorado);
            padding: 9px 14px;
            border-radius: 4px;
        }

        .carrito-btn:hover {
            background: var(--dorado);
            color: var(--negro);
        }

        /* =========================
           HERO
        ========================= */

        .hero {
            min-height: 650px;

            display: grid;
            grid-template-columns: 1fr 1fr;
            align-items: center;

            padding: 70px 9%;

            background:
                radial-gradient(
                    circle at 75% 50%,
                    #423824 0%,
                    #211e19 35%,
                    #111111 75%
                );

            color: white;
        }

        .hero-text {
            max-width: 600px;
        }

        .etiqueta {
            color: var(--dorado-claro);
            font-size: 12px;
            letter-spacing: 4px;
            margin-bottom: 20px;
            font-weight: bold;
        }

        .hero h1 {
            font-family: Georgia, serif;
            font-size: clamp(55px, 7vw, 95px);
            line-height: 0.95;
            font-weight: normal;
        }

        .hero h1 span {
            color: var(--dorado-claro);
            font-style: italic;
        }

        .hero p {
            max-width: 500px;
            color: #d0d0d0;
            margin: 30px 0;
            font-size: 16px;
        }

        .boton {
            display: inline-block;
            padding: 14px 28px;

            background: var(--dorado);
            color: var(--negro);

            border: 1px solid var(--dorado);

            font-weight: bold;
            font-size: 12px;
            letter-spacing: 1px;

            transition: 0.3s;
        }

        .boton:hover {
            background: transparent;
            color: var(--dorado-claro);
        }

        /* BOTELLA DECORATIVA */

        .hero-producto {
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 480px;
        }

        .botella {
            width: 180px;
            height: 350px;
            position: relative;

            background: linear-gradient(
                90deg,
                #4d351b,
                #9b7036,
                #4c3219
            );

            border-radius: 25px 25px 18px 18px;

            box-shadow:
                20px 25px 40px rgba(0,0,0,0.5),
                inset 10px 0 15px rgba(255,255,255,0.1);
        }

        .cuello {
            position: absolute;
            top: -70px;
            left: 52px;

            width: 76px;
            height: 80px;

            background: #6d4b25;

            border-radius: 8px 8px 0 0;
        }

        .tapon {
            position: absolute;
            top: -88px;
            left: 52px;

            width: 76px;
            height: 25px;

            background: #17120c;
            border-radius: 4px;
        }

        .etiqueta-botella {
            position: absolute;
            top: 100px;
            left: 15px;

            width: 150px;
            height: 145px;

            background: #eee4d1;
            color: #201b15;

            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;

            text-align: center;

            border: 2px solid var(--dorado);
        }

        .etiqueta-botella small {
            letter-spacing: 3px;
        }

        .etiqueta-botella strong {
            font-family: Georgia, serif;
            font-size: 27px;
            margin: 5px;
        }

        /* =========================
           CATEGORÍAS
        ========================= */

        .seccion {
            padding: 100px 8%;
        }

        .titulo-seccion {
            text-align: center;
            margin-bottom: 50px;
        }

        .titulo-seccion small {
            color: var(--dorado);
            letter-spacing: 3px;
            font-weight: bold;
        }

        .titulo-seccion h2 {
            font-family: Georgia, serif;
            font-size: 48px;
            font-weight: normal;
            margin-top: 8px;
        }

        .categorias {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
        }

        .categoria {
            height: 220px;

            background: var(--negro);
            color: white;

            display: flex;
            align-items: end;

            padding: 25px;

            position: relative;
            overflow: hidden;

            transition: 0.3s;
        }

        .categoria:hover {
            transform: translateY(-7px);
        }

        .categoria::before {
            content: "";
            position: absolute;
            inset: 0;

            background:
                radial-gradient(
                    circle at center,
                    #604c2d,
                    #181818 70%
                );

            opacity: 0.8;
        }

        .categoria-contenido {
            position: relative;
            z-index: 2;
        }

        .categoria h3 {
            font-family: Georgia, serif;
            font-size: 27px;
        }

        .categoria p {
            color: #ccc;
            font-size: 12px;
        }

        /* =========================
           PRODUCTOS
        ========================= */

        .productos {
            background: #eee9df;
        }

        .productos-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 25px;
        }

        .producto {
            background: white;
            border: 1px solid var(--borde);
            transition: 0.3s;
        }

        .producto:hover {
            transform: translateY(-6px);
            box-shadow: 0 15px 30px rgba(0,0,0,0.08);
        }

        .producto-imagen {
            height: 300px;

            background:
                radial-gradient(
                    circle,
                    #ddd2bd,
                    #b3a68e
                );

            display: flex;
            justify-content: center;
            align-items: center;

            position: relative;
        }

        .mini-botella {
            width: 75px;
            height: 180px;

            background: linear-gradient(
                90deg,
                #442d18,
                #9d7138,
                #3e2915
            );

            border-radius: 10px 10px 8px 8px;

            position: relative;

            box-shadow: 10px 15px 20px rgba(0,0,0,0.2);
        }

        .mini-botella::before {
            content: "";

            position: absolute;

            width: 32px;
            height: 35px;

            top: -30px;
            left: 21px;

            background: #4a321b;
        }

        .mini-etiqueta {
            position: absolute;

            width: 60px;
            height: 65px;

            left: 8px;
            top: 55px;

            background: #eee5d3;

            display: flex;
            align-items: center;
            justify-content: center;

            text-align: center;

            font-family: Georgia, serif;
            font-size: 10px;
        }

        .producto-info {
            padding: 20px;
        }

        .producto-info small {
            color: var(--dorado);
            letter-spacing: 2px;
            font-weight: bold;
        }

        .producto-info h3 {
            font-family: Georgia, serif;
            font-size: 22px;
            margin: 7px 0;
        }

        .producto-info p {
            color: var(--gris);
            font-size: 12px;
            margin-bottom: 18px;
        }

        .producto-final {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .precio {
            font-weight: bold;
        }

        .agregar {
            background: var(--negro);
            color: white;

            border: 0;

            padding: 9px 13px;

            font-size: 11px;
        }

        .agregar:hover {
            background: var(--dorado);
            color: var(--negro);
        }

        /* =========================
           NOSOTROS
        ========================= */

        .nosotros {
            display: grid;
            grid-template-columns: 1fr 1fr;
            min-height: 550px;
        }

        .nosotros-imagen {
            background:
                radial-gradient(
                    circle,
                    #66543b,
                    #201d18
                );

            display: flex;
            justify-content: center;
            align-items: center;

            color: var(--dorado-claro);

            font-family: Georgia, serif;
            font-size: 70px;
        }

        .nosotros-texto {
            padding: 80px 10%;
            display: flex;
            justify-content: center;
            flex-direction: column;
        }

        .nosotros-texto h2 {
            font-family: Georgia, serif;
            font-size: 50px;
            font-weight: normal;
            line-height: 1.1;
        }

        .nosotros-texto p {
            color: var(--gris);
            margin-top: 20px;
            max-width: 500px;
        }

        /* =========================
           FRASE
        ========================= */

        .frase {
            background: var(--negro);
            color: white;
            text-align: center;
            padding: 110px 10%;
        }

        .frase p {
            font-family: Georgia, serif;
            font-size: clamp(30px, 4vw, 55px);
            font-style: italic;
            max-width: 850px;
            margin: auto;
        }

        .frase span {
            display: block;
            color: var(--dorado);
            font-size: 11px;
            letter-spacing: 4px;
            margin-top: 25px;
        }

        /* =========================
           CONTACTO
        ========================= */

        .contacto {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 70px;
        }

        .contacto h2 {
            font-family: Georgia, serif;
            font-size: 50px;
            font-weight: normal;
        }

        .contacto p {
            color: var(--gris);
            margin-top: 15px;
            max-width: 450px;
        }

        form {
            display: flex;
            flex-direction: column;
            gap: 15px;
        }

        input,
        textarea {
            padding: 15px;

            border: 1px solid var(--borde);

            background: white;

            outline: none;
        }

        input:focus,
        textarea:focus {
            border-color: var(--dorado);
        }

        form button {
            align-self: flex-start;
        }

        /* =========================
           FOOTER
        ========================= */

        footer {
            background: var(--negro);
            color: white;

            padding: 60px 8% 25px;

            display: grid;
            grid-template-columns: 2fr 1fr 1fr;
            gap: 40px;
        }

        .footer-logo {
            color: var(--dorado-claro);
        }

        footer p {
            color: #aaa;
            font-size: 12px;
            margin-top: 10px;
        }

        .footer-links {
            display: flex;
            flex-direction: column;
            gap: 10px;
            font-size: 12px;
        }

        .footer-links a:hover {
            color: var(--dorado);
        }

        .copyright {
            grid-column: 1 / -1;

            border-top: 1px solid #333;

            padding-top: 20px;

            color: #777;
            font-size: 10px;
        }

        /* =========================
           CARRITO
        ========================= */

        .carrito-overlay {
            position: fixed;
            inset: 0;

            background: rgba(0,0,0,0.6);

            z-index: 3000;

            display: none;
        }

        .carrito-overlay.activo {
            display: block;
        }

        .carrito {
            background: var(--crema);

            width: min(420px, 90%);

            height: 100%;

            margin-left: auto;

            padding: 40px 30px;

            overflow-y: auto;

            position: relative;
        }

        .cerrar {
            position: absolute;
            top: 20px;
            right: 25px;

            border: 0;
            background: none;

            font-size: 28px;
        }

        .carrito h2 {
            font-family: Georgia, serif;
            font-size: 40px;
            margin-bottom: 25px;
        }

        .carrito-item {
            display: flex;
            justify-content: space-between;

            padding: 15px 0;

            border-bottom: 1px solid var(--borde);
        }

        .carrito-item h4 {
            font-family: Georgia, serif;
        }

        .eliminar {
            background: none;
            border: 0;
            text-decoration: underline;
            font-size: 11px;
        }

        .total {
            display: flex;
            justify-content: space-between;

            margin-top: 25px;

            border-top: 1px solid var(--borde);

            padding-top: 20px;
        }

        /* =========================
           RESPONSIVE
        ========================= */

        @media (max-width: 900px) {

            header {
                padding: 18px 5%;
            }

            nav {
                display: none;
            }

            .hero {
                grid-template-columns: 1fr;
                text-align: center;
            }

            .hero p {
                margin-left: auto;
                margin-right: auto;
            }

            .hero-producto {
                margin-top: 60px;
            }

            .categorias {
                grid-template-columns: repeat(2, 1fr);
            }

            .productos-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .nosotros {
                grid-template-columns: 1fr;
            }

            .nosotros-imagen {
                min-height: 400px;
            }

            .contacto {
                grid-template-columns: 1fr;
            }

            footer {
                grid-template-columns: 1fr 1fr;
            }
        }

        @media (max-width: 550px) {

            .hero {
                padding: 70px 6%;
            }

            .hero h1 {
                font-size: 58px;
            }

            .seccion {
                padding: 70px 6%;
            }

            .titulo-seccion h2 {
                font-size: 40px;
            }

            .categorias,
            .productos-grid {
                grid-template-columns: 1fr;
            }

            .nosotros-texto {
                padding: 70px 7%;
            }

            .nosotros-texto h2 {
                font-size: 40px;
            }

            .contacto h2 {
                font-size: 42px;
            }

            footer {
                grid-template-columns: 1fr;
            }

            .copyright {
                grid-column: 1;
            }
        }
    </style>
</head>

