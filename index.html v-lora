    <!-- CARRITO -->
    <div
        class="carrito-overlay"
        id="carritoOverlay"
    >

        <div class="carrito">

            <button
                class="cerrar"
                onclick="cerrarCarrito()"
            >
                ×
            </button>

            <div class="etiqueta">
                TU SELECCIÓN
            </div>

            <h2>
                Carrito
            </h2>

            <div id="listaCarrito">

                <p>
                    Tu carrito está vacío.
                </p>

            </div>

            <div class="total">

                <strong>
                    Total
                </strong>

                <strong id="total">
                    S/ 0.00
                </strong>

            </div>

        </div>

    </div>


    <script>

        /* =========================
           CARRITO
        ========================= */

        let carrito = [];


        function agregarProducto(nombre, precio) {

            carrito.push({
                nombre: nombre,
                precio: precio
            });

            actualizarCarrito();

            alert(
                nombre +
                " fue añadido al carrito."
            );
        }


        function actualizarCarrito() {

            const lista =
                document.getElementById(
                    "listaCarrito"
                );

            const contador =
                document.getElementById(
                    "contador"
                );

            const totalElemento =
                document.getElementById(
                    "total"
                );


            contador.textContent =
                carrito.length;


            if (carrito.length === 0) {

                lista.innerHTML =
                    "<p>Tu carrito está vacío.</p>";

                totalElemento.textContent =
                    "S/ 0.00";

                return;
            }


            let total = 0;


            lista.innerHTML = "";


            carrito.forEach(
                (producto, indice) => {

                    total += producto.precio;


                    const elemento =
                        document.createElement(
                            "div"
                        );

                    elemento.className =
                        "carrito-item";


                    elemento.innerHTML = `

                        <div>

                            <h4>
                                ${producto.nombre}
                            </h4>

                            <small>
                                S/ ${producto.precio.toFixed(2)}
                            </small>

                        </div>

                        <button
                            class="eliminar"
                            onclick="eliminarProducto(${indice})"
                        >
                            Eliminar
                        </button>

                    `;


                    lista.appendChild(
                        elemento
                    );

                }
            );


            totalElemento.textContent =
                "S/ " +
                total.toFixed(2);
        }


        function eliminarProducto(indice) {

            carrito.splice(indice, 1);

            actualizarCarrito();
        }


        function abrirCarrito() {

            document
                .getElementById(
                    "carritoOverlay"
                )
                .classList.add("activo");
        }


        function cerrarCarrito() {

            document
                .getElementById(
                    "carritoOverlay"
                )
                .classList.remove("activo");
        }


        /* =========================
           FORMULARIO
        ========================= */

        function enviarFormulario(event) {

            event.preventDefault();

            alert(
                "Gracias por contactar con VÉLORA. " +
                "Tu mensaje ha sido recibido."
            );

            event.target.reset();
        }


        /* =========================
           CERRAR CARRITO AL HACER
           CLIC FUERA
        ========================= */

        document
            .getElementById("carritoOverlay")
            .addEventListener(
                "click",
                function(event) {

                    if (
                        event.target === this
                    ) {

                        cerrarCarrito();

                    }

                }
            );

    </script>

