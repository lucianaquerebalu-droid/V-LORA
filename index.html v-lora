                    </div>

                </article>


                <!-- PRODUCTO 4 -->

                <article class="producto">

                    <div class="producto-imagen">

                        <div class="mini-botella">

                            <div class="mini-etiqueta">
                                VÉLORA<br>
                                ÉLITE
                            </div>

                        </div>

                    </div>


                    <div class="producto-info">

                        <small>ESPECIALES</small>

                        <h3>Élite Selection</h3>

